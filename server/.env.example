PORT=5050
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Optional comma-separated extra CORS origins (apex, preview URLs, etc.)
# CLIENT_URLS=https://dilanddata.in,https://dil-and-data.vercel.app

# Public API origin used in robots.txt Sitemap line (Render URL or custom API domain)
# API_PUBLIC_URL=https://dil-and-data-api.onrender.com/api

# MongoDB Atlas
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/dil-and-data?retryWrites=true&w=majority

# JWT — REQUIRED in production (never use the default)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
JWT_COOKIE_NAME=dil_token

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=dil-and-data

# Rate limiting (Studio autosave needs a generous ceiling)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000

# Registration is closed after the first admin exists.
# Set true only for emergency bootstrap of additional author accounts.
ALLOW_REGISTER=false

# Optional admin seed overrides (npm run seed:admin)
# SEED_ADMIN_EMAIL=admin@dilanddata.com
# SEED_ADMIN_PASSWORD=ChangeMe123!
# SEED_ADMIN_NAME=Manogna
# FORCE_SEED=true
